{
  "name": "@codify/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:watch",
    "dev:watch": "nodemon --watch src --ext ts --delay 500ms --exec \"node --experimental-specifier-resolution=node --loader ts-node/esm src/main.ts\"",
    "build": "tsc --noEmit",
    "source:sync": "node --experimental-specifier-resolution=node --loader ts-node/esm scripts/syncSourceRepository.ts",
    "start": "node --experimental-specifier-resolution=node --loader ts-node/esm src/main.ts"
  },
  "dependencies": {
    "@codify/agent": "workspace:*",
    "@codify/contracts": "workspace:*",
    "@codify/evolving-agent": "workspace:*",
    "@codify/design2code": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "@logtail/node": "^0.5.8",
    "@nestjs/common": "^10.4.20",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "better-auth": "^1.6.18",
    "dotenv": "^16.4.7",
    "express": "^4.22.1",
    "juice": "^11.1.1",
    "lru-cache": "7.18.3",
    "onnxruntime-common": "1.24.3",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.42.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^25.3.3",
    "@types/pngjs": "^6.0.5",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
